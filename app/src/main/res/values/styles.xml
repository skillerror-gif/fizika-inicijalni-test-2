<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/physics_white</item>
        <item name="android:colorAccent">@color/physics_blue</item>
        <item name="colorPrimary">@color/physics_blue</item>
        <item name="colorPrimaryVariant">@color/physics_navy_2</item>
        <item name="colorSecondary">@color/physics_cyan</item>
        <item name="android:navigationBarColor">@color/physics_white</item>
        <item name="android:statusBarColor">@color/physics_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/physics_navy</item>
        <item name="android:textColorSecondary">@color/physics_muted</item>
        <item name="android:buttonStyle">@style/PhysicsButton</item>
        <item name="android:radioButtonStyle">@style/PhysicsRadioButton</item>
        <item name="android:textViewStyle">@style/PhysicsTextView</item>
    </style>

    <style name="PhysicsTextView" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/physics_navy</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="PhysicsButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/physics_button_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/physics_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="PhysicsRadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">@color/physics_navy</item>
        <item name="buttonTint">@color/physics_blue</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:background">@drawable/answer_option_background</item>
    </style>
</resources>
