<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/physics_shadow" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/physics_light_blue" />
                    <stroke android:width="2dp" android:color="@color/physics_blue" />
                    <corners android:radius="18dp" />
                    <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/physics_shadow" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/physics_white" />
                    <stroke android:width="2dp" android:color="@color/physics_border" />
                    <corners android:radius="18dp" />
                    <padding android:left="16dp" android:top="14dp" android:right="16dp" android:bottom="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
