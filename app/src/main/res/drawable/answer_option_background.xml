<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/physics_light_blue" />
            <stroke android:width="2dp" android:color="@color/physics_blue" />
            <corners android:radius="16dp" />
            <padding android:left="10dp" android:top="8dp" android:right="10dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/physics_white" />
            <stroke android:width="1dp" android:color="@color/physics_border" />
            <corners android:radius="16dp" />
            <padding android:left="10dp" android:top="8dp" android:right="10dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
